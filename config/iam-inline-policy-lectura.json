{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PermitirSubirYLeer",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::<NOMBRE_DEL_BUCKET>/uploads/*"
    },
    {
      "Sid": "PermitirListarUploads",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<NOMBRE_DEL_BUCKET>",
      "Condition": {
        "StringLike": { "s3:prefix": "uploads/*" }
      }
    }
  ]
}
